{
  "name": "bencho-frontend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json && eslint . && prettier --check . && vite build",
    "storybook": "storybook dev -p 10006 --no-open",
    "build:storybook": "storybook build",
    "test:db": "docker compose -p perf-test --profile test up -d --wait postgres-test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "i18next": "26.4.5",
    "lucide-react": "1.57.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
