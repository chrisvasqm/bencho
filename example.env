# Copy to .env. Every value is optional; defaults shown.

# Target API (local QuickPizza from compose.yaml). Public alternative: https://quickpizza.grafana.com
BASE_URL=http://localhost:3333
# Host port for the local QuickPizza container; keep BASE_URL in sync.
QUICKPIZZA_PORT=3333

# Seconds each virtual user waits between requests.
THINK_TIME_SECONDS=1

# Pass/fail limits. Error rate is a fraction (0.01 = 1%). Latency percentiles in ms.
MAX_ERROR_RATE=0.01
P50_MS=200
P90_MS=400
P95_MS=500
P99_MS=1000

# Replaces the test's load shape: comma-separated <duration>:<VUs>. Unset = test default.
# STAGES=30s:10,1m:10,30s:0
