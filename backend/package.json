{
  "name": "bencho-backend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/app/src/server.js",
    "build:k6": "tsx scripts/build-k6.ts",
    "build": "tsc -p tsconfig.build.json && pnpm build:k6",
    "load": "pnpm build:k6 && tsx scripts/run.ts load",
    "stress": "pnpm build:k6 && tsx scripts/run.ts stress",
    "spike": "pnpm build:k6 && tsx scripts/run.ts spike",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit && eslint . && prettier --check . && pnpm build",
    "test": "vitest run",
    "test:db": "docker compose -p perf-test --profile test up -d --wait postgres-test",
    "e2e:server": "tsx scripts/e2e-server.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/k6": "2.3.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
