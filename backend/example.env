# Copy to .env. Every value is optional; defaults shown.

# Backend
PORT=3000
DATABASE_URL=postgres://perf:perf@localhost:10002/perf
# Target offered to the frontend as default. Inside compose the backend uses http://quickpizza:3333.
DEFAULT_BASE_URL=http://localhost:10001
# Target of the SOAP example flow (unset in production: no SOAP example). Inside compose the backend uses http://soap-demo:8080.
SOAP_EXAMPLE_BASE_URL=http://localhost:10007
# Runs may target private, loopback and link-local addresses unless this is exactly false
# (true or empty allows; anything else is a startup error). Set it to false when people who
# must not load-test your own network can reach Bencho.
# ALLOW_PRIVATE_TARGETS=false

# CLI runs (pnpm load|stress|spike) read these; the API takes them per request instead.
BASE_URL=http://localhost:10001
THINK_TIME_SECONDS=1
MAX_ERROR_RATE=0.01
P50_MS=200
P90_MS=400
P95_MS=500
P99_MS=1000
# STAGES=30s:10,1m:10,30s:0
